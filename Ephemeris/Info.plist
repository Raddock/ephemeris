<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundleHelpBookFolder</key>
    <string>Ephemeris Help.help</string>
    <key>CFBundleHelpBookName</key>
    <string>com.macobservatory.Ephemeris.help</string>
    <key>NSHumanReadableCopyright</key>
    <string>Copyright © 2026 Andrew Burwell. Licensed under GPLv3.</string>
    <!-- Sparkle 2 auto-update. The appcast is uploaded as an asset on each GitHub
         release; the /latest/download/ URL always resolves to the newest one. -->
    <key>SUFeedURL</key>
    <string>https://github.com/Raddock/ephemeris/releases/latest/download/appcast.xml</string>
    <!-- EdDSA public key for update signatures. The private half lives in the
         signing Mac's login Keychain (generated 2026-07-07 with Sparkle's
         generate_keys). Release archives must be signed on that machine, or the
         key exported/imported first: `generate_keys -x/-f`. -->
    <key>SUPublicEDKey</key>
    <string>EzaQnBBCbGOLtr63RCjFo7zcUeGbF+J7IUaHPMPXZEs=</string>
    <!-- Required for sandboxed apps: route installs through Sparkle's XPC service. -->
    <key>SUEnableInstallerLauncherService</key>
    <true/>
    <!-- SUEnableAutomaticChecks is deliberately absent: setting it (to either
         value) suppresses Sparkle's standard consent prompt. Leaving it unset
         makes Sparkle ask the user on second launch and store their choice. -->
</dict>
</plist>
